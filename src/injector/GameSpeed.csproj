<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameSpeed</AssemblyName>
    <RootNamespace>GameSpeed</RootNamespace>
    <!-- Injector and target must agree on bitness, so there is no AnyCPU
         build: publish picks win-x64 or win-x86 explicitly. -->
    <Platforms>x64;x86</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Globalization-invariant mode must stay off. WinForms handles
         WM_INPUTLANGCHANGE by building a CultureInfo from the new layout's
         LCID, and in invariant mode CultureInfo.GetCultureInfo(1033) throws:
         switching keyboard layout with the filter box focused killed the
         window with CultureNotFoundException. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The Battlegrounds overlay is sized from the game's client rect in
         physical pixels; a DPI-virtualized window would land scaled and
         offset. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The overlay copies its pixels straight into a DIB section. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- One program: the overlay's half of the sources builds into this exe. -->
  <ItemGroup>
    <Compile Include="..\bgoverlay\*.cs" Link="Battlegrounds\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\bgoverlay\TribeIcons\*.jpg"
                      Link="TribeIcons\%(Filename)%(Extension)"
                      LogicalName="GameSpeed.TribeIcons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\bgoverlay\BattlegroundsIcons\*.png"
                      Link="BattlegroundsIcons\%(Filename)%(Extension)"
                      LogicalName="GameSpeed.BattlegroundsIcons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\bgoverlay\BattlegroundsIcons\Minion\*.png"
                      Link="BattlegroundsIcons\Minion\%(Filename)%(Extension)"
                      LogicalName="GameSpeed.BattlegroundsIcons.Minion.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
